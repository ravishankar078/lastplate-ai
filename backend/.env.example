# LastPlate Backend Environment Configuration
PROJECT_NAME="LastPlate Backend"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=true

# Server Binding
HOST="127.0.0.1"
PORT=8000

# CORS Origins
ALLOWED_ORIGINS='["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]'

# Secret Key for JWT (Phase 5)
SECRET_KEY="temporary-dev-secret-key-change-in-production-lastplate"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL 16)
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD=""
POSTGRES_DB="lastplate"
DATABASE_URL="postgresql+asyncpg://postgres:@localhost:5432/lastplate"
SYNC_DATABASE_URL="postgresql+psycopg2://postgres:@localhost:5432/lastplate"
