# ==============================================================================
# LastPlate Production Environment Configuration Template
# Copy to .env.production and provide production credentials before deploying
# ==============================================================================

# Core Project Settings
PROJECT_NAME="LastPlate Production"
API_V1_STR="/api/v1"
ENVIRONMENT="production"
DEBUG=false

# Host & Binding
HOST="0.0.0.0"
PORT=8000

# CORS Whitelist (JSON array of trusted client domains)
ALLOWED_ORIGINS='["https://lastplate.org","https://app.lastplate.org"]'

# Cryptographic Security (Generate with: openssl rand -hex 64)
SECRET_KEY="GENERATE_A_SECURE_64_CHAR_HEX_KEY_FOR_PRODUCTION_USE"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL 16 Credentials (Secure internal network)
POSTGRES_SERVER="db"
POSTGRES_PORT=5432
POSTGRES_USER="lastplate_admin"
POSTGRES_PASSWORD="REPLACE_WITH_STRONG_GENERATED_PASSWORD"
POSTGRES_DB="lastplate_prod"

# Connection Strings
DATABASE_URL="postgresql+asyncpg://lastplate_admin:REPLACE_WITH_STRONG_GENERATED_PASSWORD@db:5432/lastplate_prod"
SYNC_DATABASE_URL="postgresql+psycopg2://lastplate_admin:REPLACE_WITH_STRONG_GENERATED_PASSWORD@db:5432/lastplate_prod"

# Food Safety Regulation Thresholds
HOT_HOLDING_MIN_TEMP_C=60.0
COLD_HOLDING_MAX_TEMP_C=5.0
PERISHABLE_MAX_WINDOW_HOURS=4.0
